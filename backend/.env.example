APP_ENV=development
APP_VERSION=1.0.0
API_PREFIX=/api

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

MODEL_PATH=models/best.pt
MOCK_MODE=auto

CONFIDENCE_THRESHOLD=0.50
STANDARD_MATCH_THRESHOLD=90
DEFECT_RATE_ALERT_THRESHOLD=10

SEVERITY_LOW_THRESHOLD=0.5
SEVERITY_MEDIUM_THRESHOLD=2.0
SEVERITY_HIGH_THRESHOLD=5.0

MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

DATABASE_FALLBACK=sqlite:///./forgeguard.db